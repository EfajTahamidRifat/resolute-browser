# Resolute (Chromium) build arguments. scripts/build.sh appends target_cpu.

target_os = "android"
is_debug = false
is_component_build = false

# App size and speed (2026-11-12). The first APK was 526 MB because it was a
# developer build: its main code file (libchrome.so) was 407 MB, full of
# developer self-checks (DCHECKs) and without the size optimisations Chrome
# ships with. "Official" turns on the release optimisations Chrome uses
# (link-time optimisation, identical-code folding, no DCHECKs).
is_official_build = true
dcheck_always_on = false
# Chrome uses Google's profile data (PGO) for official builds; we don't have it.
chrome_pgo_phase = 0

# No VR / AR / Cardboard / Android XR: large libraries almost nobody uses in a
# browser (the XR library alone was 19 MB).
enable_vr = false
enable_arcore = false
enable_cardboard = false
enable_openxr = false

# No debug symbols: much smaller build output, which matters on CI runners.
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0

# Chromium builds its extension system for Android in the "desktop Android"
# configuration. This is what enables Chrome Web Store extensions.
is_desktop_android = true

# Media codecs (H.264, AAC, ...) like Chrome.
proprietary_codecs = true
ffmpeg_branding = "Chrome"

# Skip Java static analysis (lint, Error Prone): saves hours and disk on CI.
android_static_analysis = "off"
treat_warnings_as_errors = false

# Build with Ninja, not Siso. Our CI resumes a half-finished build in the next
# stage from the saved out/ folder; Ninja trusts file timestamps for that, while
# local Siso rebuilt everything from zero in each stage.
use_siso = false

# Use features' default states, not Google's field-trial experiments.
disable_fieldtrial_testing_config = true

# Resolute's Android package name.
chrome_public_manifest_package = "com.resolute.browser"
