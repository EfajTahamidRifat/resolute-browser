+namespace {
+
+// Resolute: Android phones have no side panel UI, but the API still reported
+// success, so wallets like MetaMask (which now prefer the side panel) waited
+// forever with nothing on screen. Failing here makes them fall back to their
+// popup window, which works. Not constexpr on purpose, so the compiler doesn't
+// flag the code after the check as unreachable.
+bool SidePanelUiAvailable() {
+#if BUILDFLAG(IS_ANDROID)
+  return false;
+#else
+  return true;
+#endif
+}
+
+}  // namespace
+
 ExtensionFunction::ResponseAction SidePanelOpenFunction::RunFunction() {
   // Only available to extensions.
   EXTENSION_FUNCTION_VALIDATE(extension());
 
+  if (!SidePanelUiAvailable()) {
+    return RespondNow(Error("Side panel is not available on this device."));
+  }
+
   // `sidePanel.open()` requires a user gesture.
   if (!user_gesture()) {
     return RespondNow(
