+
+    // Resolute (patch 0022): the wallet button (patch 0021) gets a soft Resolute-red pill
+    // behind its icon, so it stands out in the bottom bar like the design's red wallet button.
+    private static void maybeStyleAsWalletButton(ListMenuButton button, @Nullable String id) {
+        boolean isWallet = false;
+        for (String walletId : ExtensionActionListMediator.RESOLUTE_WALLET_IDS) {
+            if (walletId.equals(id)) isWallet = true;
+        }
+        // Buttons are recycled between extensions: remember the original background once
+        // and restore it for anything that is not the wallet.
+        if (!(button.getTag() instanceof Drawable[])) {
+            button.setTag(new Drawable[] {button.getBackground()});
+        }
+        Drawable original = ((Drawable[]) button.getTag())[0];
+        if (!isWallet) {
+            button.setBackground(original);
+            return;
+        }
+        float density = button.getResources().getDisplayMetrics().density;
+        GradientDrawable pill = new GradientDrawable();
+        pill.setShape(GradientDrawable.RECTANGLE);
+        pill.setCornerRadius(999 * density);
+        pill.setColor(0x33E10600);
+        pill.setStroke(Math.round(1.5f * density), 0xFFE10600);
+        Drawable glow =
+                new InsetDrawable(
+                        pill,
+                        Math.round(4 * density),
+                        Math.round(10 * density),
+                        Math.round(4 * density),
+                        Math.round(10 * density));
+        button.setBackground(
+                original == null ? glow : new LayerDrawable(new Drawable[] {glow, original}));
+    }
