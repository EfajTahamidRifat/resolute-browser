     // NativePage overrides
 
+    // Resolute (patch 0031): at start-up the new tab override can be reported a moment before
+    // Resolute Home is ready to open, and the first try then shows "... is blocked"
+    // (ERR_BLOCKED_BY_CLIENT; E2E run 45035269793 after a restart). Try again, up to this many
+    // times, one second apart.
+    private static final int RESOLUTE_HOME_RETRIES = 8;
+
+    /** Resolute: replaces this tab's page with Resolute Home, retrying while it is blocked. */
+    private static void loadResoluteHome(Tab tab, int retriesLeft) {
+        if (retriesLeft > 0) {
+            tab.addObserver(
+                    new TabObserver() {
+                        @Override
+                        public void onDidFinishNavigationInPrimaryMainFrame(
+                                Tab observedTab, NavigationHandle navigation) {
+                            observedTab.removeObserver(this);
+                            if (navigation.errorCode() != NetError.ERR_BLOCKED_BY_CLIENT) return;
+                            PostTask.postDelayedTask(
+                                    TaskTraits.UI_DEFAULT,
+                                    () -> {
+                                        if (observedTab.isDestroyed()) return;
+                                        loadResoluteHome(observedTab, retriesLeft - 1);
+                                    },
+                                    1000);
+                        }
+                    });
+        }
+        LoadUrlParams params = new LoadUrlParams("chrome://newtab/");
+        params.setShouldReplaceCurrentEntry(true);
+        tab.loadUrl(params);
+    }
+
