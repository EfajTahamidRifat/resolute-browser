{
  "key": "",
  "manifest_version": 3,
  "name": "Resolute Home",
  "version": "1.0.0",
  "description": "Resolute's home screen: your level, quests, shortcuts and Resolute Picks.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "topSites",
    "search",
    "management",
    "favicon",
    "history"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*"
  ]
}